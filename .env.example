# ---------------------------------------------------------------------------
# Copy this file to `.env` for local development:  cp .env.example .env
#
# Every value here is server-side only. None of them is ever sent to the
# browser. `.env` is git-ignored — never commit real credentials.
#
# In production you do NOT use this file: you paste the same names and values
# into your Vercel project's Environment Variables settings. See the
# "Deploying to Vercel" section of README.md.
# ---------------------------------------------------------------------------

# === Required in production ===============================================

# Postgres connection string. Any Postgres works — Neon, Supabase, RDS, or a
# local server. In a serverless deployment use the provider's POOLED (also
# called "pooler", "connection pooling" or "PgBouncer") connection string:
# every warm function instance opens its own connections, and the direct
# string runs out of them.
#   Neon      → the string labelled "Pooled connection"
#   Supabase  → Connection Pooling → Transaction mode (port 6543)
# Locally, add ?sslmode=disable for a Postgres server without TLS.
DATABASE_URL=postgres://user:password@host:5432/trivia

# Protects GET /api/cron/refresh, the scheduled content-generation endpoint.
# Vercel Cron sends it automatically as `Authorization: Bearer <secret>`.
# Without it that endpoint refuses every request and no new questions are
# generated on a schedule. Generate one with:  openssl rand -hex 32
CRON_SECRET=change-me-to-32-random-characters


# === Required for Current Events and Science ==============================

# Geography needs no key at all: its answers come from structured datasets
# through deterministic templates. Current Events and Science are written by a
# model from fetched source material, and need this.
# Get one at https://console.anthropic.com → API keys.
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium
# ANTHROPIC_MAX_TOKENS=16000
# Fail a generation before the platform kills the function. Defaults to 45s on
# Vercel and 5 minutes from the command line.
# ANTHROPIC_TIMEOUT_MS=45000


# === Optional =============================================================

# The origin used to build shareable challenge and daily-challenge links.
# Leave this UNSET unless you need to pin it: with no value the API uses the
# origin each request actually arrives on, so links are correct on your
# *.vercel.app URL, on preview deployments and on a custom domain, with nothing
# to update when the domain changes. Set it only to force one canonical origin,
# e.g. https://trivia.example.com — no trailing slash.
# PUBLIC_BASE_URL=https://trivia.example.com

# When set, `X-Admin-Key: <value>` makes GET /api/trivia return the full
# question record (including correctAnswer) for server-to-server use and
# content review. Leave unset to disable that entirely.
# TRIVIA_ADMIN_KEY=change-me-too

# Cross-origin sites allowed to call this API from a browser, comma separated.
# Empty (the default) means same-origin only, which is what the game itself
# needs — it is served from the same domain as its API. Set this only if
# another site must call the API directly. `*` allows any origin and never
# grants credentials.
# ALLOWED_ORIGINS=https://theentropic.studio

# How many categories one scheduled /api/cron/refresh run may refresh. Each is
# an upstream fetch plus a model call, and a serverless invocation has a hard
# time limit, so the default is one per run — the most overdue category first,
# with the next run taking the next one.
# CRON_CATEGORIES_PER_RUN=1

# Database TLS. The certificate is verified by default. Set this only if your
# provider presents a self-signed certificate (adding ?sslmode=no-verify to
# DATABASE_URL does the same thing).
# PGSSL_NO_VERIFY=1

# Connections per pool instance. Defaults to 3 on Vercel, 10 elsewhere.
# PGPOOL_MAX=3


# --- Content freshness (milliseconds) --------------------------------------
# REFRESH_CURRENT_EVENTS_MS=2700000     # 45 minutes
# REFRESH_SCIENCE_MS=21600000           # 6 hours
# REFRESH_GEOGRAPHY_MS=2592000000       # 30 days
# POOL_CURRENT_EVENTS=80
# POOL_SCIENCE=80
# POOL_GEOGRAPHY=150
# BATCH_CURRENT_EVENTS=30
# BATCH_SCIENCE=30
# BATCH_GEOGRAPHY=120

# --- Gameplay tuning --------------------------------------------------------
# DEFAULT_QUESTION_COUNT=10
# DAILY_QUESTION_COUNT=10
# QUESTION_TIME_LIMIT_MS=20000
# MIN_PLAUSIBLE_RESPONSE_MS=750
# How long a request may wait for the very first refresh when the bank is
# empty, before telling the player it is still being built.
# COLD_START_WAIT_MS=12000

# --- Abuse limits -----------------------------------------------------------
# Account creation is limited per IP address, so raise this if your players
# share an egress address (a school, an office, carrier NAT).
# PLAYER_CREATE_LIMIT_PER_HOUR=10
# SESSION_LIMIT_PER_HOUR=60
# ANSWER_LIMIT_PER_HOUR=400

# --- Source overrides -------------------------------------------------------
# Comma-separated `Name|feed-url` pairs. Defaults are wire services and public
# broadcasters; override to use your own sources.
# NEWS_FEEDS=Reuters|https://…,BBC News|https://…
# SCIENCE_FEEDS=NASA|https://…
