# ---------------------------------------------------------------------------
# Copy to .env for local development. Every value here is server-side only.
# None of these are ever sent to the browser.
# ---------------------------------------------------------------------------

# Required. Postgres connection string (Neon, Supabase, RDS, local…).
# Use a POOLED connection string in serverless environments.
DATABASE_URL=postgres://user:password@host:5432/trivia

# Required for Current Events, Science, General Knowledge and Entertainment question generation.
# Geography works without it (structured data + deterministic templates).
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=medium

# Public origin, used to build shareable invite/daily-quiz URLs.
PUBLIC_BASE_URL=http://localhost:3000

# Protects /api/cron/refresh. Vercel Cron sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=change-me

# Optional. When set, `X-Admin-Key: <value>` makes /api/trivia return the full
# question record (including correctAnswer) for server-to-server use and review.
# TRIVIA_ADMIN_KEY=change-me-too

# Comma-separated allowed CORS origins. `*` reflects any origin.
# ALLOWED_ORIGINS=https://mygame.com

# --- Content freshness (milliseconds) ---------------------------------------
# Every category refreshes once a day and produces one fixed quiz that every
# player shares for that UTC day (see README). 24h is the default for all five.
# REFRESH_CURRENT_EVENTS_MS=86400000     # 24 hours
# REFRESH_SCIENCE_MS=86400000            # 24 hours
# REFRESH_GEOGRAPHY_MS=86400000          # 24 hours
# REFRESH_GENERAL_KNOWLEDGE_MS=86400000  # 24 hours
# REFRESH_ENTERTAINMENT_MS=86400000      # 24 hours
# Questions generated per refresh: the day's quiz plus spares for rejects.
# BATCH_CURRENT_EVENTS=9
# BATCH_SCIENCE=9
# BATCH_GEOGRAPHY=9
# BATCH_GENERAL_KNOWLEDGE=9
# BATCH_ENTERTAINMENT=9

# --- Gameplay tuning --------------------------------------------------------
# DAILY_QUESTION_COUNT=5
# QUESTION_TIME_LIMIT_MS=20000
# MIN_PLAUSIBLE_RESPONSE_MS=750
# SCORING_BASE_POINTS=150
# SCORING_MAX_SPEED_BONUS=75

# --- Source overrides -------------------------------------------------------
# Comma-separated `Name|feed-url` pairs. Defaults are wire services and public
# broadcasters; override to use your own sources. General Knowledge sources
# from Wikipedia's "On This Day" API and Entertainment from Wikipedia page
# summaries; neither has a feed override.
# NEWS_FEEDS=Reuters|https://…,BBC News|https://…
# SCIENCE_FEEDS=NASA|https://…
